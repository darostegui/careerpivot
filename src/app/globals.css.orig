@import "tailwindcss";

:root {
  --background: #0a0a0a;
  --foreground: #ededed;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
}

@media (prefers-color-scheme: light) {
  :root:not([data-theme="dark"]) {
    --background: #f8fafc;
    --foreground: #171717;
  }
}

body {
  background: var(--background);
  color: var(--foreground);
  font-family: var(--font-geist-sans), Arial, Helvetica, sans-serif;
  transition: background-color 180ms ease, color 180ms ease;
}

[data-theme="light"] {
  --background: #f8fafc;
  --foreground: #171717;
}

[data-theme="light"] .bg-zinc-950 {
  background-color: #f8fafc !important;
}

[data-theme="light"] .bg-zinc-900,
[data-theme="light"] .bg-zinc-900\/80,
[data-theme="light"] .bg-zinc-900\/70,
[data-theme="light"] .bg-zinc-900\/60,
[data-theme="light"] .bg-zinc-900\/55,
[data-theme="light"] .bg-zinc-900\/50,
[data-theme="light"] .bg-zinc-900\/30 {
  background-color: #ffffff !important;
}

[data-theme="light"] .bg-zinc-900\/80 {
  background-color: #f1f5f9 !important;
  color: #047857 !important;
}

[data-theme="light"] .bg-zinc-800,
[data-theme="light"] .bg-zinc-800\/60 {
  background-color: #e2e8f0 !important;
}

[data-theme="light"] .border-zinc-900,
[data-theme="light"] .border-zinc-800,
[data-theme="light"] .border-zinc-700 {
  border-color: #cbd5e1 !important;
}

[data-theme="light"] .text-white {
  color: #0f172a !important;
}

[data-theme="light"] .text-zinc-100 {
  color: #0f172a !important;
}

[data-theme="light"] .text-zinc-200 {
  color: #1e293b !important;
}

[data-theme="light"] .text-zinc-300,
[data-theme="light"] .text-zinc-400 {
  color: #475569 !important;
}

[data-theme="light"] .text-zinc-500 {
  color: #64748b !important;
}

[data-theme="light"] .text-emerald-200,
[data-theme="light"] .text-emerald-300,
[data-theme="light"] .text-emerald-400,
[data-theme="light"] .text-emerald-500 {
  color: #047857 !important;
}

[data-theme="light"] .text-zinc-950 {
  color: #0f172a !important;
}

[data-theme="light"] .text-cyan-100,
[data-theme="light"] .text-cyan-200,
[data-theme="light"] .text-cyan-300,
[data-theme="light"] .text-cyan-400 {
  color: #155e75 !important;
}

[data-theme="light"] .text-amber-300,
[data-theme="light"] .text-amber-400 {
  color: #b45309 !important;
}

[data-theme="light"] .text-red-300 {
  color: #b91c1c !important;
}

[data-theme="light"] .hover\:text-emerald-200:hover,
[data-theme="light"] .hover\:text-emerald-300:hover,
[data-theme="light"] .hover\:text-emerald-400:hover,
[data-theme="light"] .group:hover .group-hover\:text-emerald-300 {
  color: #065f46 !important;
}

[data-theme="light"] .divide-zinc-800 > :not([hidden]) ~ :not([hidden]) {
  border-color: #e2e8f0 !important;
}

[data-theme="light"] .hover\:bg-zinc-800:hover {
  background-color: #e2e8f0 !important;
}

[data-theme="light"] .hover\:text-white:hover {
  color: #0f172a !important;
}

[data-theme="light"] .fixed.bg-zinc-900\/90 {
  background-color: rgb(255 255 255 / 0.92) !important;
}

.career-upload-page__dropzone,
.career-upload-page__role {
  background-color: rgb(24 24 27 / 0.4);
}

.career-upload-page__signal {
  background-color: rgb(24 24 27 / 0.6);
}

.career-upload-page__submit {
  color: #000000;
  background-color: #ffffff;
}

[data-theme="light"] .career-upload-page__dropzone,
[data-theme="light"] .career-upload-page__role,
[data-theme="light"] .career-upload-page__signal {
  background-color: #ffffff;
}

[data-theme="light"] .career-upload-page__submit {
  color: #ffffff;
  background-color: #0f172a;
}

[data-theme="light"] .career-upload-page__submit:hover {
  background-color: #1e293b;
}

[data-theme="light"] .career-upload-page .text-emerald-300 {
  color: #047857 !important;
}

.roadmap-panel {
  background-color: rgb(24 24 27 / 0.95);
  border-color: #3f3f46;
  color: #f4f4f5;
}

[data-theme="light"] .module-experience .text-zinc-100 {
  color: #0f172a !important;
}

[data-theme="light"] .module-experience .text-zinc-200 {
  color: #1e293b !important;
}

[data-theme="light"] .module-experience .text-zinc-300,
[data-theme="light"] .module-experience .text-zinc-400 {
  color: #475569 !important;
}

[data-theme="light"] .module-experience .border-zinc-800 {
  border-color: #e2e8f0 !important;
}

[data-theme="light"] .module-experience .bg-gradient-to-br.from-emerald-500\/15 {
  background: linear-gradient(to bottom right, rgba(16, 185, 129, 0.1), #ffffff, rgba(6, 182, 212, 0.05)) !important;
}

[data-theme="light"] .module-experience .bg-zinc-900\/55,
[data-theme="light"] .module-experience .bg-zinc-900\/70 {
  background-color: #ffffff !important;
}

[data-theme="light"] .roadmap-panel {
  background-color: rgb(255 255 255 / 0.97);
  border-color: #cbd5e1;
  color: #0f172a;
}

[data-theme="light"] .roadmap-panel .text-zinc-100 {
  color: #0f172a !important;
}

[data-theme="light"] .roadmap-panel .text-emerald-200,
[data-theme="light"] .roadmap-panel .text-emerald-300 {
  color: #047857 !important;
}

[data-theme="light"] .roadmap-panel .text-cyan-200 {
  color: #0e7490 !important;
}

[data-theme="light"] .roadmap-panel .border-zinc-800 {
  border-color: #e2e8f0 !important;
}

[data-theme="light"] .roadmap-panel .border-zinc-700 {
  border-color: #cbd5e1 !important;
}

[data-theme="light"] .roadmap-panel .hover\:text-white:hover {
  color: #0f172a !important;
}

[data-theme="light"] .roadmap-flow-node {
  color: #0f172a !important;
  border-width: 1px !important;
  border-style: solid !important;
  box-shadow: 0 10px 30px rgb(15 23 42 / 0.08);
}

[data-theme="light"] .roadmap-flow-node--current,
[data-theme="light"] .roadmap-flow-node--step {
  background: #ffffff !important;
  border-color: #cbd5e1 !important;
}

[data-theme="light"] .roadmap-flow-node--mastered {
  background: #ecfdf5 !important;
  border-color: #6ee7b7 !important;
  color: #065f46 !important;
}

[data-theme="light"] .roadmap-flow-node--target {
  background: #ecfeff !important;
  border-color: #67e8f9 !important;
  color: #155e75 !important;
}

[data-theme="light"] .react-flow__controls,
[data-theme="light"] .react-flow__controls-button,
[data-theme="light"] .react-flow__minimap {
  background: #ffffff !important;
  border-color: #cbd5e1 !important;
}

[data-theme="light"] .react-flow__controls-button {
  color: #334155 !important;
}

[data-theme="light"] .react-flow__attribution a {
  color: #475569 !important;
}

.career-not-found {
  --career-not-found-plank-height: clamp(120px, 17vh, 190px);
  min-height: 100dvh;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 24px;
  color: #e2e8f0;
  background:
    radial-gradient(120% 130% at 0% 100%, rgb(16 185 129 / 0.12), transparent 55%),
    linear-gradient(105deg, #071b1a 0%, #102d2d 60%, #0a2224 100%);
}

.career-not-found__wood {
  position: fixed;
  inset: auto 0 0;
  height: var(--career-not-found-plank-height);
  z-index: 2;
  pointer-events: none;
  background: url("/404-wood.jpg") bottom center / auto 100% repeat-x;
  box-shadow: 0 -18px 30px -10px rgb(2 12 12 / 0.6);
}

.career-not-found__goat {
  position: fixed;
  left: clamp(8px, 3vw, 70px);
  bottom: calc(var(--career-not-found-plank-height) - clamp(70px, 9vh, 120px));
  z-index: 1;
  height: clamp(300px, 56vh, 560px);
  width: auto;
  user-select: none;
  pointer-events: none;
  filter: drop-shadow(0 14px 22px rgb(0 0 0 / 0.45));
}

.career-not-found__goat img {
  display: block;
  height: 100%;
  width: auto;
}

.career-not-found__content {
  position: relative;
  z-index: 3;
  width: min(480px, 100%);
  padding: 0 7vw 0 24px;
  text-align: left;
  animation: career-not-found-rise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
}

@keyframes career-not-found-rise {
  from { opacity: 0; transform: translateY(14px); }
  to { opacity: 1; transform: translateY(0); }
}

.career-not-found__logo {
  display: inline-block;
  margin-bottom: 36px;
  color: #f8fafc;
  font-size: 1.5rem;
  font-weight: 800;
  letter-spacing: -0.04em;
  text-decoration: none;
}

.career-not-found__logo span {
  color: #34d399;
}

.career-not-found__code {
  margin-bottom: 8px;
  padding-bottom: 0.06em;
  color: transparent;
  font-size: clamp(5rem, 13vw, 9rem);
  font-weight: 800;
  line-height: 1.08;
  letter-spacing: -0.04em;
  background: linear-gradient(135deg, #6ee7b7 0%, #10b981 45%, #047857 100%);
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.career-not-found h1 {
  margin-bottom: 12px;
  color: #ffffff;
  font-size: clamp(1.6rem, 3.4vw, 2.1rem);
  font-weight: 700;
  letter-spacing: -0.02em;
}

.career-not-found__subtitle {
  max-width: 30ch;
  margin-bottom: 32px;
  color: #a7c2bd;
  font-size: 1.02rem;
  line-height: 1.6;
}

.career-not-found__actions {
  display: flex;
  max-width: 280px;
  flex-direction: column;
  gap: 12px;
}

.career-not-found__button {
  display: inline-flex;
  width: 100%;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  padding: 14px 26px;
  font-size: 0.97rem;
  font-weight: 600;
  text-decoration: none;
  transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
}

.career-not-found__button--primary {
  color: #022c22;
  background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
  box-shadow: 0 8px 22px rgb(16 185 129 / 0.3);
}

.career-not-found__button--primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 28px rgb(16 185 129 / 0.4);
}

.career-not-found__button--secondary {
  border: 1px solid rgb(255 255 255 / 0.16);
  color: #d1e3df;
  background: rgb(10 35 34 / 0.65);
  cursor: pointer;
  font: inherit;
}

.career-not-found__button--secondary:hover {
  color: #ffffff;
  background: rgb(23 61 58 / 0.8);
}

.career-not-found__bubble {
  display: none;
  position: fixed;
  left: clamp(300px, 24vw, 560px);
  bottom: clamp(320px, 58vh, 620px);
  z-index: 4;
  min-width: 240px;
  max-width: 340px;
  padding: 17px 22px;
  border-radius: 20px;
  color: #17312d;
  background: #ecfdf5;
  font-size: 1.04rem;
  font-weight: 500;
  line-height: 1.5;
  box-shadow: 0 14px 36px rgb(2 12 12 / 0.45);
  transform-origin: 28px 100%;
  animation: career-not-found-bubble 420ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.career-not-found__bubble::after {
  content: "";
  position: absolute;
  left: 28px;
  bottom: -15px;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 18px 22px 0 0;
  border-color: #ecfdf5 transparent transparent transparent;
}

@keyframes career-not-found-bubble {
  0% { opacity: 0; transform: scale(0.2); }
  55% { opacity: 1; }
  100% { opacity: 1; transform: scale(1); }
}

@media (min-width: 821px) {
  .career-not-found__bubble {
    display: block;
  }

  .career-not-found__subtitle {
    display: none;
  }
}

@media (max-width: 820px) {
  .career-not-found {
    --career-not-found-plank-height: clamp(96px, 13vh, 150px);
    align-items: flex-start;
    justify-content: center;
  }

  .career-not-found__goat {
    left: 50%;
    bottom: clamp(28px, 5vh, 56px);
    height: clamp(190px, 28vh, 280px);
    opacity: 0.9;
    transform: translateX(-50%);
  }

  .career-not-found__content {
    max-width: 100%;
    padding: clamp(28px, 7vh, 64px) 24px 0;
    text-align: center;
  }

  .career-not-found__subtitle {
    max-width: 100%;
    margin-right: auto;
    margin-left: auto;
    font-size: 0.95rem;
  }

  .career-not-found__actions {
    margin: 0 auto;
  }
}

@media (prefers-reduced-motion: reduce) {
  .career-not-found__content,
  .career-not-found__bubble {
    animation: none;
  }
}
